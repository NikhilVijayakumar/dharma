# Example — matches config/dharma-repo.toml. Copy to .env in a consuming
# repository's root and uncomment values to configure:
#   cp env/dharma-repo.env.example .env

# Absolute path to this repository's .dharma/ directory (repo.db,
# domain-summary.md, agent-summary.md — all generated by Dharma's sync
# flow). Unset falls back to <repo>/.dharma.
# DHARMA_DIR=

# Absolute path to Dharma MCP's own data directory (where mcp.db lives) —
# this repository registers against and syncs from here. Unset falls back
# to the platform default MCP data directory.
# DHARMA_MCP_DIR=

# Absolute path for domain-summary.md / agent-summary.md, if kept outside
# DHARMA_DIR. Unset falls back to <repo>/.dharma.
# DHARMA_REPORT_DIR=

# Absolute path to this repository's documentation root — repo_config.docs_dir.
# Unset leaves the column NULL (no documentation section declared).
# DHARMA_DOCS_DIR=

# Absolute path to this repository's implementation dir — repo_config.implementation_dir.
# Unset leaves the column NULL.
# DHARMA_IMPLEMENTATION_DIR=

# Absolute path to this repository's tests dir — repo_config.tests_dir.
# Unset leaves the column NULL.
# DHARMA_TESTS_DIR=

# Absolute path to this repository's scripts dir — repo_config.scripts_dir.
# Unset leaves the column NULL.
# DHARMA_SCRIPTS_DIR=
