# Example — matches config/dharma-build.toml. Copy to .env in dharma's own
# repository root and uncomment values to configure:
#   cp env/dharma-build.env.example .env

# Absolute path to this repository's documentation root.
# Unset falls back to <repo>/docs.
# DHARMA_DOCS_DIR=

# Absolute path to this repository's implementation/source directory
# (the Cargo workspace root). Unset falls back to <repo>/crates.
# DHARMA_IMPLEMENTATION_DIR=

# Absolute path for generated reports (e.g. docs-compliance/build reports).
# Unset falls back to <repo>/docs/report.
# DHARMA_REPORT_DIR=
