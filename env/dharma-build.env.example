# Example — matches dharma-build.toml (dharma's own repository root; see
# config.example/dharma-build.toml for that template). Copy to .env in
# dharma's own repository root and uncomment values to configure:
#   cp env/dharma-build.env.example .env

# Absolute path to this repository's documentation root.
# Unset falls back to <repo>/docs.
# DHARMA_DOCS_DIR=

# Absolute path to this repository's implementation/source directory
# (the Cargo workspace root). Unset falls back to <repo>/crates.
# DHARMA_IMPLEMENTATION_DIR=

# Absolute path for generated reports (e.g. docs-compliance/build reports).
# Unset falls back to <repo>/docs/report.
# DHARMA_REPORT_DIR=

# Absolute path for the packaged release (scripts/build-release.{sh,ps1} /
# crates/xtask). Unset falls back to <repo>/release.
# DHARMA_BUILD_OUTPUT_DIR=

# Build validity window baked into dharma-mcp (crates/mcp/build.rs) — it
# refuses to start once expired. Set DHARMA_BUILD_EXPIRY_DAYS=-1 for a build
# that never expires. Unset falls back to 30 days, 0 hours.
# DHARMA_BUILD_EXPIRY_DAYS=30
# DHARMA_BUILD_EXPIRY_HOURS=0
