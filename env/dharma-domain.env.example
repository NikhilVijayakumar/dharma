# Example — matches config/dharma-domain.toml. Copy to .env in a Domain
# System provider repository's root and uncomment values to configure:
#   cp env/dharma-domain.env.example .env

# Absolute path to this provider's domain/section/epic/usecase/task source
# files — walked by Dharma's capture flow. Unset falls back to <repo>/domain.
# DHARMA_DOMAIN_CONTENT_DIR=

# Absolute path to Dharma MCP's own data directory (where mcp.db lives) —
# this provider registers its Domain System here. Unset falls back to the
# platform default MCP data directory.
# DHARMA_MCP_DIR=
