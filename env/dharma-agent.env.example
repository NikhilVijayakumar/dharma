# Example — matches config/dharma-agent.toml. Copy to .env in an Agent
# System provider repository's root and uncomment values to configure:
#   cp env/dharma-agent.env.example .env

# Absolute path to this provider's agent/skill source files (agent YAML
# definitions, skill prompt/script/example files) — walked by Dharma's
# capture flow. Unset falls back to <repo>/agents.
# DHARMA_AGENT_CONTENT_DIR=

# Absolute path to Dharma MCP's own data directory (where mcp.db lives) —
# this provider registers its Agent System here. Unset falls back to the
# platform default MCP data directory.
# DHARMA_MCP_DIR=
